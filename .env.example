# --- the test image (compose.yml build args): the CI matrix runs every supported pair.
# Ruby version of the image (ruby:<version>-slim-bookworm): 3.2, 3.3, 3.4, 4.0.
TEST_RUBY_VERSION=3.4
# Dependency set: Gemfile (Minitest 6) or gemfiles/minitest5.gemfile (Minitest 5).
TEST_GEMFILE=Gemfile

# --- the model for `docker compose run --rm agentic` (example/e2e.config.ts reads these).
# Unset E2E_MODEL = no model: agent steps fail with MODEL_UNAVAILABLE.
# E2E_MODEL_PROVIDER: openai-compatible (any OpenAI-compatible server, e.g. a local vLLM) or gateway.
E2E_MODEL=
E2E_MODEL_PROVIDER=
# openai-compatible: the server's base URL including /v1, e.g. http://localhost:8000/v1.
E2E_MODEL_BASE_URL=
# openai-compatible: its API key, if it wants one.
E2E_MODEL_API_KEY=
# gateway: the Vercel AI Gateway key (read by the `ai` package); E2E_MODEL = <provider>/<model>.
AI_GATEWAY_API_KEY=

# --- a model server reachable only on a docker network (compose.model-network.yml):
# COMPOSE_FILE=compose.yml:compose.model-network.yml
# E2E_MODEL_NETWORK=
