# Model for the agentic example (example/spec/agentic_spec.rb), a Vercel AI Gateway id
# such as "<provider>/<model>". Unset: agent steps fail with MODEL_UNAVAILABLE.
E2E_MODEL=
# Key for the Vercel AI Gateway, read by the `ai` package.
AI_GATEWAY_API_KEY=
# 1: print every e2e step as it ends.
E2E_RB_VERBOSE=0
